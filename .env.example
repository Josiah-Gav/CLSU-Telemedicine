# Development defaults. The values in this file are for local XAMPP work; the
# comments call out where production (Hostinger) must differ. Nothing here is a
# real credential, and nothing here should ever become one.
#
# Production must set at minimum:
#   APP_ENV=production   APP_DEBUG=false   APP_URL=https://<production-domain>
#   APP_KEY=<generated fresh, never the development key>
#   SESSION_SECURE_COOKIE=true
#   LOG_LEVEL=error   LOG_STACK=daily
#   CLOUDINARY_URL, the JITSI_* group, and real SMTP credentials.

APP_NAME="CLSU Telemedicine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging. LOG_LEVEL=error in production: debug records far more context than
# a medical system should retain in a log. On a persistent host such as
# Hostinger, LOG_STACK=daily rotates storage/logs/ instead of growing one file
# without bound.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Marks the session cookie Secure so a browser will not send it over plain
# HTTP. config/session.php has NO default for this, so leaving it unset means
# the cookie is not marked Secure at all.
#
# Production (anything served over HTTPS): true.
# Local XAMPP over plain http://localhost: leave false, or the browser will
# discard the cookie and every login will appear to silently fail.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport. Both Mailtrap modes below use the plain "smtp" mailer, so
# switching between them is an .env-only change — no code or config edits.
# Leave MAIL_SCHEME=null: Laravel 12 has no MAIL_ENCRYPTION setting, and a null
# scheme lets Symfony pick the right one from the port (587/2525 = STARTTLS,
# 465 = implicit TLS). Setting MAIL_ENCRYPTION does nothing.
#
# Mailtrap Sandbox (development — mail is captured, never delivered):
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<sandbox inbox username>
#   MAIL_PASSWORD=<sandbox inbox password>
#
# Mailtrap Email Sending (presentation — mail is delivered to real recipients):
#   MAIL_HOST=live.smtp.mailtrap.io
#   MAIL_PORT=587
#   MAIL_USERNAME=api
#   MAIL_PASSWORD=<Mailtrap API token>
#   MAIL_FROM_ADDRESS must be an address on a domain verified in Mailtrap.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="CLSU Telemedicine"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary — REQUIRED. Every medical attachment and prescription is uploaded
# here by App\Services\MedicalFileStorage with delivery type "authenticated",
# and is read back through a short-lived signed URL minted only after the
# request has been authorized. Without this the application still works, but
# every upload falls back to the private local disk (storage/app/medical),
# which must then be backed up along with the database.
#
# One URL carries the cloud name, the API key AND the API secret:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Copy it from the Cloudinary console. Never commit a real value.
CLOUDINARY_URL=

# Seconds an upload may take before it is abandoned and the local fallback is
# used. See config/cloudinary.php.
# CLOUDINARY_UPLOAD_TIMEOUT=10

# Lifetime of a signed medical-file download URL, in seconds.
# CLOUDINARY_SIGNED_URL_TTL=300

VITE_APP_NAME="${APP_NAME}"

# Jitsi as a Service (JaaS / 8x8) — video consultations.
# Credentials come from the JaaS console: https://jaas.8x8.vc/#/apikeys
# Never commit real values.
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=
JITSI_API_KEY_ID=
# RSA private key on a single line, with newlines escaped as literal \n
JITSI_PRIVATE_KEY=

# Physician consultation intake. Non-secret operational limits;
# see config/consultations.php for what each one buys.
CONSULTATION_QUEUE_LIMIT=20
CONSULTATION_INTAKE_STALE_AFTER=120
