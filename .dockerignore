# Build context exclusions.
#
# The first two entries are security, not size: .env holds the Cloudinary
# secret, the Jitsi private key and the mail password, and storage/app/medical
# holds real medical files plus the pre-migration backup. Neither may ever be
# baked into an image layer, where it would survive every later RUN that
# appears to delete it.

.env
.env.*
!.env.example

storage/app/medical
storage/app/public
storage/app/private
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/debugbar

# Rebuilt inside the image; copying the host's copies would ship the wrong
# platform's binaries and stale assets.
vendor
node_modules
public/build
public/hot
public/storage

# Local-only tooling and history.
.git
.gitignore
.github
.vscode
.idea
.fleet
.nova
.zed
.playwright-mcp
.phpunit.cache
.phpunit.result.cache
.phpactor.json
auth.json

# Development databases and docs that have no runtime role.
database/database.sqlite
laravel
docs
design-system
README.md
CLAUDE.md
